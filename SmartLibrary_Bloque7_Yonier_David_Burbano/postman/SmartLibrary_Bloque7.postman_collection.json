{
  "info": {
    "name": "SmartLibrary - Bloque 7 | 5 escenarios",
    "description": "Ejecutar en orden con la app recien iniciada y la BD en memoria reiniciada. Evidencias solo de resultados reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Libro disponible (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/prestamos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prestamos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"estudianteId\":1,\"libroId\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
